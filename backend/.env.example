# Copy this to .env and fill in real values before starting the server.
# In production, set these as environment variables in your hosting dashboard (Railway / Render / Fly.io).

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev only)
# DATABASE_URL=sqlite:///./dhanrakshak.db
# PostgreSQL (production — recommended)
DATABASE_URL=postgresql://user:password@host:5432/dhanrakshak

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Storage ───────────────────────────────────────────────────────────────────
# Local (dev only) — use S3/R2/Supabase Storage in production
STORAGE_DIR=./storage/uploads

# ── CORS (add your Vercel / Netlify URL here) ────────────────────────────────
EXTRA_CORS_ORIGIN=https://your-app.vercel.app

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable production-only validation checks
ENV=production
